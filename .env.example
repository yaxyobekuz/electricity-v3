# Namuna. Nusxa oling: `cp .env.example .env`

# --- Ma'lumotlar bazasi ---
# Format: postgresql://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electricity_v3?schema=public"

# Har bir SQL so'rovni terminalga chiqarish (faqat so'rovlarni sozlash paytida): 1
PRISMA_LOG_QUERIES=""

# `pg_restore` va `psql` turgan papka - /imports sahifasidagi "Boshqa serverdan
# baza nusxasi" uchun. PATH da bo'lsa bo'sh qoldiring.
# Windows: C:\Program Files\PostgreSQL\17\bin
PG_BIN=""

# --- Ilova ---
NODE_ENV=development

# --- Google Maps (xarita sahifasi) ---
# Google Cloud Console'dan Maps JavaScript API kaliti. Mahfiy - .env.local'da
# saqlang, git'ga tushirmang. Bo'sh bo'lsa xarita ko'rsatma paneli chiqadi.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
