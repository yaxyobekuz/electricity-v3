# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
.turbo/
next-env.d.ts

# production
/build
/dist

# typescript
*.tsbuildinfo

# prisma generated client
/src/generated

# env files (keep .env.example tracked)
.env
.env.*
!.env.example

# secrets / certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# local databases, dumps and backups
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz
/backups

# vercel
.vercel

# caches
.cache/
.eslintcache
.stylelintcache
*.tmp
*.temp
tmp/
temp/

# editors / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# OS files
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Office lock files (open Excel templates)
~$*

# Claude Code local files (docs/commands stay tracked)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# namunaviy (test) Excel fayllar - scripts/sample-data.ts
/.samples
