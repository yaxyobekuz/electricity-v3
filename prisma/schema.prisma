// Elektr energiyasi analitik platformasi - ma'lumotlar bazasi sxemasi.
//
// Ierarxiya (Excel shablonlari bilan bir xil):
//   Podstansiya -> Fider -> Transformator (TP) -> Abonent
//   Qoidabuzarlik va Murojaat - TP ga (ixtiyoriy ravishda abonentga) bog'lanadi.
//
// Ikki qatlam:
//   1. **Obyektlar** (Substation, Feeder, Transformer, Subscriber, Staff) -
//      oydan oyga o'zgarmaydigan identifikator. URL'dagi `id` shu.
//   2. **Oylik holatlar** (*Snapshot, Violation, Appeal) - har bir hisobot oyi
//      (`Period`) uchun Excel'dan kelgan qiymatlar. Bir oyga shablon qayta
//      yuklansa, shu oyning shu shablondagi yozuvlari to'liq almashtiriladi.
//
// Batafsil qoidalar: `.claude/docs/malumotlar.md`.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Hisobot davri
// ---------------------------------------------------------------------------

/// Hisobot oyi. Excel varaq nomidagi sanadan ("13-sentabr, 2026") aniqlanadi.
model Period {
  id         String   @id @default(cuid())
  /// Oyning birinchi kuni, masalan 2026-09-01. Davrning kaliti.
  month      DateTime @unique @db.Date
  /// Shu oyga yuklangan fayllardagi eng so'nggi hisobot sanasi (varaq nomidan).
  reportDate DateTime @db.Date

  substationSnapshots  SubstationSnapshot[]
  feederSnapshots      FeederSnapshot[]
  transformerSnapshots TransformerSnapshot[]
  subscriberSnapshots  SubscriberSnapshot[]
  violations           Violation[]
  appeals              Appeal[]
  importBatches        ImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("periods")
}

// ---------------------------------------------------------------------------
// Obyektlar (oydan oyga barqaror)
// ---------------------------------------------------------------------------

/// Ma'sul / biriktirilgan xodim. Shablonlarda faqat F.I.Sh. matni keladi.
model Staff {
  id      String @id @default(cuid())
  /// Fayldagi ko'rinishi (birinchi uchragan yozuv).
  name    String
  /// Solishtirish kaliti: `nameKey()` (kichik harf, apostrof va bo'shliqlar bir xil).
  nameKey String @unique

  substationSnapshots  SubstationSnapshot[]
  feederSnapshots      FeederSnapshot[]
  transformerSnapshots TransformerSnapshot[]
  subscriberSnapshots  SubscriberSnapshot[]
  violations           Violation[]
  appeals              Appeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff")
}

/// Podstansiya ("Elektr Podstansiyalar.xlsx" -> "Podstansiya Nomi").
model Substation {
  id      String @id @default(cuid())
  name    String
  nameKey String @unique

  feeders      Feeder[]
  transformers Transformer[]
  snapshots    SubstationSnapshot[]
  violations   Violation[]
  appeals      Appeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("substations")
}

/// Fider. Nomi faqat podstansiya ichida noyob.
model Feeder {
  id           String @id @default(cuid())
  substationId String
  name         String
  nameKey      String

  substation   Substation       @relation(fields: [substationId], references: [id], onDelete: Cascade)
  transformers Transformer[]
  snapshots    FeederSnapshot[]
  violations   Violation[]
  appeals      Appeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([substationId, nameKey])
  @@index([substationId])
  @@map("feeders")
}

/// Transformator punkti (TP). Nomi faqat fider ichida noyob; matn sifatida
/// saqlanadi ("07" dagi nol yo'qolmasin).
model Transformer {
  id           String @id @default(cuid())
  /// Fider orqali ham topiladi, lekin so'rovlar uchun takrorlab saqlanadi.
  /// TP ning fideri (demak podstansiyasi ham) hech qachon o'zgarmaydi -
  /// fider kalitning bir qismi.
  substationId String
  feederId     String
  name         String
  nameKey      String

  substation          Substation            @relation(fields: [substationId], references: [id], onDelete: Cascade)
  feeder              Feeder                @relation(fields: [feederId], references: [id], onDelete: Cascade)
  snapshots           TransformerSnapshot[]
  subscriberSnapshots SubscriberSnapshot[]
  violations          Violation[]
  appeals             Appeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feederId, nameKey])
  @@index([substationId])
  @@index([nameKey])
  @@map("transformers")
}

/// Abonent. Oydan oyga "Shartnoma raqami" orqali taniladi.
model Subscriber {
  id             String @id @default(cuid())
  /// Fayldagi ko'rinishi.
  contractNumber String
  /// Solishtirish kaliti: `contractKey()` (bo'shliqsiz, katta harf).
  contractKey    String @unique

  snapshots  SubscriberSnapshot[]
  violations Violation[]
  appeals    Appeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscribers")
}

// ---------------------------------------------------------------------------
// Oylik holatlar (Excel qatorlari)
// ---------------------------------------------------------------------------

/// "Elektr Podstansiyalar.xlsx" qatori.
model SubstationSnapshot {
  id            String  @id @default(cuid())
  periodId      String
  substationId  String
  importBatchId String?
  /// Excel'dagi qator raqami (xatolik va manba ko'rsatish uchun).
  rowNumber     Int
  /// Excel qatorining asl ko'rinishi: sarlavha -> qiymat (shablonda yo'q ustunlar ham).
  /// Platformada ko'rsatilmasa ham fayldagi hech bir ma'lumot yo'qolmaydi.
  sourceRow     Json?

  /// "Umumiy oqim", kWh.
  totalKwh    Decimal  @db.Decimal(18, 2)
  /// "Foydali oqim", kWh.
  usefulKwh   Decimal  @db.Decimal(18, 2)
  /// "Yo'qotish", kWh. Manfiy bo'lishi mumkin.
  lossKwh     Decimal  @db.Decimal(18, 2)
  address     String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  /// "Quvvati (KVA)".
  capacityKva Decimal? @db.Decimal(12, 2)
  staffId     String?

  period      Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  substation  Substation   @relation(fields: [substationId], references: [id], onDelete: Cascade)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([periodId, substationId])
  @@index([substationId])
  @@index([staffId])
  @@map("substation_snapshots")
}

/// "Elektr Fiderlar.xlsx" qatori.
model FeederSnapshot {
  id            String  @id @default(cuid())
  periodId      String
  feederId      String
  importBatchId String?
  rowNumber     Int
  /// Excel qatorining asl ko'rinishi: sarlavha -> qiymat (shablonda yo'q ustunlar ham).
  /// Platformada ko'rsatilmasa ham fayldagi hech bir ma'lumot yo'qolmaydi.
  sourceRow     Json?

  totalKwh    Decimal  @db.Decimal(18, 2)
  usefulKwh   Decimal  @db.Decimal(18, 2)
  lossKwh     Decimal  @db.Decimal(18, 2)
  address     String?
  capacityKva Decimal? @db.Decimal(12, 2)
  staffId     String?

  period      Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  feeder      Feeder       @relation(fields: [feederId], references: [id], onDelete: Cascade)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([periodId, feederId])
  @@index([feederId])
  @@index([staffId])
  @@map("feeder_snapshots")
}

/// "Elektr Transformatorlar.xlsx" qatori.
model TransformerSnapshot {
  id            String  @id @default(cuid())
  periodId      String
  transformerId String
  importBatchId String?
  rowNumber     Int
  /// Excel qatorining asl ko'rinishi: sarlavha -> qiymat (shablonda yo'q ustunlar ham).
  /// Platformada ko'rsatilmasa ham fayldagi hech bir ma'lumot yo'qolmaydi.
  sourceRow     Json?

  totalKwh           Decimal   @db.Decimal(18, 2)
  usefulKwh          Decimal   @db.Decimal(18, 2)
  lossKwh            Decimal   @db.Decimal(18, 2)
  /// "Aloqadagi abonentlar".
  onlineSubscribers  Int
  /// "Aloqadan chiqqan abonentlar".
  offlineSubscribers Int
  address            String?
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  capacityKva        Decimal?  @db.Decimal(12, 2)
  /// "Joriy ta'mir sanasi".
  currentRepairDate  DateTime? @db.Date
  /// "To'la ta'mir sanasi".
  overhaulDate       DateTime? @db.Date
  staffId            String?

  period      Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  transformer Transformer  @relation(fields: [transformerId], references: [id], onDelete: Cascade)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([periodId, transformerId])
  @@index([transformerId])
  @@index([staffId])
  @@map("transformer_snapshots")
}

/// "Elektr Abonentlar.xlsx" qatori.
model SubscriberSnapshot {
  id            String  @id @default(cuid())
  periodId      String
  subscriberId  String
  /// Shu oydagi TP (abonent boshqa TP ga o'tishi mumkin).
  transformerId String
  importBatchId String?
  rowNumber     Int
  /// Excel qatorining asl ko'rinishi: sarlavha -> qiymat (shablonda yo'q ustunlar ham).
  /// Platformada ko'rsatilmasa ham fayldagi hech bir ma'lumot yo'qolmaydi.
  sourceRow     Json?

  /// "FISH".
  fullName         String
  /// "Abonent turi (Yuridik/Aholi)".
  kind             SubscriberKind
  /// "Holati (Aloqada / Aloqaga chiqmayotgan / Sxemasi o'zgartirilgan)".
  meterStatus      MeterStatus
  /// "Biriktirilgan xodim".
  staffId          String?
  address          String?
  latitude         Decimal?       @db.Decimal(9, 6)
  longitude        Decimal?       @db.Decimal(9, 6)
  /// "Hisoblagich zavod raqami".
  meterSerial      String?
  /// "Hisoblagich turi".
  meterType        String?
  /// "Qarzdorlik", so'm. Bo'sh katak = 0.
  debtUzs          Decimal        @default(0) @db.Decimal(18, 2)
  /// "Haqdorlik", so'm. Bo'sh katak = 0.
  creditUzs        Decimal        @default(0) @db.Decimal(18, 2)
  /// "Hisoblagich ko'rsatgichi".
  meterReading     Decimal?       @db.Decimal(18, 2)
  /// "Oxirgi olingan ma'lumot".
  lastReadingAt    DateTime?
  /// "Oxirgi to'langan to'lov" (sana).
  lastPaymentDate  DateTime?      @db.Date
  /// "Oxirgi to'langan summa", so'm.
  lastPaymentUzs   Decimal?       @db.Decimal(18, 2)
  /// "Shartnoma sanasi".
  contractDate     DateTime?      @db.Date
  /// Shaxsiy ma'lumot - ro'yxat va qidiruvda ko'rsatilmaydi.
  passport         String?
  /// Shaxsiy ma'lumot - ro'yxat va qidiruvda ko'rsatilmaydi.
  pinfl            String?
  /// "Hisoblagich o'rnatilingan sana".
  meterInstalledAt DateTime?      @db.Date

  period      Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subscriber  Subscriber   @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  transformer Transformer  @relation(fields: [transformerId], references: [id], onDelete: Cascade)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([periodId, subscriberId])
  @@index([periodId, transformerId])
  @@index([subscriberId])
  @@index([staffId])
  @@map("subscriber_snapshots")
}

/// "Elektr Qoidabuzarliklar.xlsx" qatori.
model Violation {
  id            String  @id @default(cuid())
  periodId      String
  /**
   * Bog'lanish (malumotlar.md 4.3d): TP "TP Nomi" yoki abonent shartnoma raqami
   * orqali topilsa - TP, fider va podstansiya; TP topilmasa, lekin ma'sul xodim
   * shu oyda bitta podstansiyaga biriktirilgan bo'lsa - faqat podstansiya.
   * Hech biri topilmasa - uchalasi ham null (yozuv baribir saqlanadi).
   */
  transformerId String?
  feederId      String?
  substationId  String?
  /// Abonent shartnoma raqami yoki nomi bo'yicha bir ma'noli topilsa - bog'lanadi.
  subscriberId  String?
  importBatchId String?
  rowNumber     Int
  /// Excel qatorining asl ko'rinishi: sarlavha -> qiymat (shablonda yo'q ustunlar ham).
  /// Platformada ko'rsatilmasa ham fayldagi hech bir ma'lumot yo'qolmaydi.
  sourceRow     Json?

  /// "Abonent" - fayldagi matn.
  subscriberName String
  /// "Turi (Yuridik/Jismoniy/Aybisiz)".
  violatorType   ViolatorType
  /// "Sana".
  date           DateTime     @db.Date
  address        String?
  /// "Keltirilgan zarar miqdori (UZS)". Bo'sh katak = 0.
  damageUzs      Decimal      @default(0) @db.Decimal(18, 2)
  /// "Taxminiy zarar (kWh)". Bo'sh katak = 0.
  damageKwh      Decimal      @default(0) @db.Decimal(18, 2)
  staffId        String?

  period      Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  transformer Transformer? @relation(fields: [transformerId], references: [id], onDelete: SetNull)
  feeder      Feeder?      @relation(fields: [feederId], references: [id], onDelete: SetNull)
  substation  Substation?  @relation(fields: [substationId], references: [id], onDelete: SetNull)
  subscriber  Subscriber?  @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([periodId, transformerId])
  @@index([periodId, feederId])
  @@index([periodId, substationId])
  @@index([transformerId])
  @@index([subscriberId])
  @@index([staffId])
  @@map("violations")
}

/// "Elektr Murojaatlar.xlsx" qatori.
model Appeal {
  id            String  @id @default(cuid())
  periodId      String
  /**
   * Bog'lanish (malumotlar.md 4.3d): TP "TP Nomi" yoki abonent shartnoma raqami
   * orqali topilsa - TP, fider va podstansiya; TP topilmasa, lekin ma'sul xodim
   * shu oyda bitta podstansiyaga biriktirilgan bo'lsa - faqat podstansiya.
   * Hech biri topilmasa - uchalasi ham null (yozuv baribir saqlanadi).
   */
  transformerId String?
  feederId      String?
  substationId  String?
  subscriberId  String?
  importBatchId String?
  rowNumber     Int
  /// Excel qatorining asl ko'rinishi: sarlavha -> qiymat (shablonda yo'q ustunlar ham).
  /// Platformada ko'rsatilmasa ham fayldagi hech bir ma'lumot yo'qolmaydi.
  sourceRow     Json?

  /// "Murojaat" - murojaat matni.
  text           String
  /// "Abonent" - fayldagi matn.
  subscriberName String
  /// "Sana".
  date           DateTime     @db.Date
  address        String?
  /// "Holati (Ijobiy hal etilgan / Rad etilgan / Jarayonda / Muddati buzilgan)".
  status         AppealStatus
  staffId        String?

  period      Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  transformer Transformer? @relation(fields: [transformerId], references: [id], onDelete: SetNull)
  feeder      Feeder?      @relation(fields: [feederId], references: [id], onDelete: SetNull)
  substation  Substation?  @relation(fields: [substationId], references: [id], onDelete: SetNull)
  subscriber  Subscriber?  @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([periodId, transformerId])
  @@index([periodId, feederId])
  @@index([periodId, substationId])
  @@index([transformerId])
  @@index([subscriberId])
  @@index([staffId])
  @@index([periodId, status])
  @@map("appeals")
}

// ---------------------------------------------------------------------------
// Yuklash tarixi
// ---------------------------------------------------------------------------

/// Bitta faylni yuklash urinishi. Xato bo'lsa `FAILED` bilan qayd etiladi va
/// bazaga hech qanday ma'lumot yozilmaydi (butun yuklash rad etiladi).
model ImportBatch {
  id           String       @id @default(cuid())
  templateType TemplateType
  status       ImportStatus
  fileName     String
  fileSize     Int
  sheetName    String?

  /// Aniqlangan hisobot oyi (xato varaq nomida bo'lsa - null).
  periodId   String?
  /// Varaq nomidagi sana.
  reportDate DateTime? @db.Date

  /// Ma'lumot qatorlari soni.
  totalRows   Int @default(0)
  /// Shu oyda avval bo'lmagan va endi qo'shilgan yozuvlar.
  createdRows Int @default(0)
  /// Shu oyda avval bor bo'lgan va yangilangan yozuvlar.
  updatedRows Int @default(0)
  /// Shu oyda avval bor bo'lgan, yangi faylda yo'q - o'chirilgan yozuvlar.
  removedRows Int @default(0)

  /// Xatolar: [{ row, column, message }]. `status = FAILED` bo'lsa to'ldiriladi.
  errors   Json?
  /// Ogohlantirishlar (yuklashni to'xtatmaydi): [{ row, column, message }].
  warnings Json?

  uploadedById String?

  period     Period? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  substationSnapshots  SubstationSnapshot[]
  feederSnapshots      FeederSnapshot[]
  transformerSnapshots TransformerSnapshot[]
  subscriberSnapshots  SubscriberSnapshot[]
  violations           Violation[]
  appeals              Appeal[]

  createdAt DateTime @default(now())

  @@index([templateType])
  @@index([periodId])
  @@index([createdAt])
  @@map("import_batches")
}

// ---------------------------------------------------------------------------
// Foydalanuvchilar (autentifikatsiya keyinroq)
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  imports ImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ---------------------------------------------------------------------------
// Enum'lar
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

/// Excel shablon turi. Yuklash tartibi shu ro'yxat tartibida.
enum TemplateType {
  /// Elektr Podstansiyalar.xlsx
  SUBSTATIONS
  /// Elektr Fiderlar.xlsx
  FEEDERS
  /// Elektr Transformatorlar.xlsx
  TRANSFORMERS
  /// Elektr Abonentlar.xlsx
  SUBSCRIBERS
  /// Elektr Qoidabuzarliklar.xlsx
  VIOLATIONS
  /// Elektr Murojaatlar.xlsx
  APPEALS
}

enum ImportStatus {
  COMPLETED
  FAILED
}

/// "Abonent turi".
enum SubscriberKind {
  /// Yuridik
  LEGAL
  /// Aholi
  HOUSEHOLD
}

/// Abonent "Holati".
enum MeterStatus {
  /// Aloqada
  ONLINE
  /// Aloqaga chiqmayotgan
  NOT_RESPONDING
  /// Sxemasi o'zgartirilgan
  SCHEME_CHANGED
}

/// Qoidabuzarlik "Turi".
enum ViolatorType {
  /// Yuridik
  LEGAL
  /// Jismoniy
  INDIVIDUAL
  /// Aybisiz
  INNOCENT
}

/// Murojaat "Holati".
enum AppealStatus {
  /// Ijobiy hal etilgan
  RESOLVED
  /// Rad etilgan
  REJECTED
  /// Jarayonda
  IN_PROGRESS
  /// Muddati buzilgan
  OVERDUE
}
